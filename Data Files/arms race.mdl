arms expenditure A= INTEG (inflow A-outflow A,
		initial arms expenditure A)
	~	
	~		|

arms expenditure B= INTEG (inflow B-outflow B,
		initial arms expenditure B)
	~	
	~		|

fear responsiveness A=1
	~	
	~		|

fear responsiveness B=1
	~	
	~		|

grievance A=1
	~	
	~		|

grievance B=1
	~	
	~		|

inflow A=arms expenditure B perception of A*fear responsiveness A+grievance A
	~	
	~		|

inflow B=arms expenditure A perception of B*fear responsiveness B+grievance B
	~	
	~		|

initial arms expenditure A=100
	~	
	~		|

initial arms expenditure B=100
	~	
	~		|

outflow A=restraint A*arms expenditure A
	~	
	~		|

outflow B=restraint B*arms expenditure B
	~	
	~		|

perception delay time of A=1
	~	
